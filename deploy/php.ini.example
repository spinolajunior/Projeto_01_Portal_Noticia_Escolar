; Aplicar no PHP do servidor; não é lido automaticamente pelo portal.
display_errors = Off
display_startup_errors = Off
log_errors = On
expose_php = Off
zend.exception_ignore_args = On
upload_max_filesize = 10M
post_max_size = 12M
memory_limit = 256M
session.use_strict_mode = 1
session.use_only_cookies = 1
session.cookie_httponly = 1
session.cookie_samesite = Lax
; session.cookie_secure = 1 quando o acesso for exclusivamente HTTPS.
