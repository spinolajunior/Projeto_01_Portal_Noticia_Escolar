# Exemplo para Apache 2.4 no servidor previsto no DEF; ajustar o caminho real.
# ServerTokens e ServerSignature devem ficar na configuração global.
ServerTokens Prod
ServerSignature Off

<VirtualHost *:80>
    DocumentRoot /var/www/portal_cetidam/application
    <Directory /var/www/portal_cetidam/application>
        Options +FollowSymLinks -Indexes -MultiViews
        AllowOverride All
        Require all granted
    </Directory>
    ErrorLog ${APACHE_LOG_DIR}/cetidam-error.log
    CustomLog ${APACHE_LOG_DIR}/cetidam-access.log combined
</VirtualHost>

# Ativar mod_rewrite e o handler PHP/FPM adotado no servidor.
# Para implantação definitiva, configurar TLS e redirecionar HTTP para HTTPS.
# Não publicar sem validar a configuração com apachectl configtest.
